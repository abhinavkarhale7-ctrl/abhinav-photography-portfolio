# .env.local.example (rename to .env.local for local development)

# General Site Information
NEXT_PUBLIC_OWNER_NAME="Abhinav Karhale"
NEXT_PUBLIC_SITE_TITLE="Photography"
NEXT_PUBLIC_SITE_DESCRIPTION="Selected photographic work by Abhinav Karhale."
NEXT_PUBLIC_STORE_NAME="" # Your Store Name
NEXT_PUBLIC_SITE_URL="https://abhinavkarhale-photography.vercel.app" # Confirm Vercel assigns this exact address
NEXT_PUBLIC_ALT_URL=""

# Image Buckets
NEXT_PUBLIC_IMAGE_BUCKET_URL="" # https://img.yourdomain.com
NEXT_PUBLIC_BLOG_BUCKET_URL="" # https://blog-img.yourdomain.com
NEXT_PUBLIC_ABOUT_BUCKET_URL="" # https://about-img.yourdomain.com
NEXT_PUBLIC_CUSTOM_BUCKET_URL="" # https://custom-img.yourdomain.com
NEXT_PUBLIC_STREAM_BUCKET_URL="" # https://stream-files.yourdomain.com
NEXT_PUBLIC_FILES_BUCKET_URL="" # https://files.yourdomain.com
NEXT_PUBLIC_BUCKETS_URL="" # https://*.yourdomain.com

# Image Domain Configuration
NEXT_PUBLIC_IMAGE_DOMAIN="" # yourdomain.com (domain pattern for Next.js image optimization)

# SEO Configuration
NEXT_PUBLIC_SEO_JOB_TITLE="" # Photographer
NEXT_PUBLIC_SEO_PROFESSION="" # professional photographer specializing in landscapes and portraits
NEXT_PUBLIC_SEO_LOCALITY="" # London
NEXT_PUBLIC_SEO_REGION="" # England
NEXT_PUBLIC_SEO_COUNTRY="IN"

# OpenGraph
NEXT_PUBLIC_OG_SITE_NAME="Abhinav Karhale Photography"
NEXT_PUBLIC_OG_IMAGE_URL="https://abhinavkarhale-photography.vercel.app/api/og?title=Abhinav%20Karhale%20Photography"
NEXT_PUBLIC_OG_IMAGE_ALT="Photography by Abhinav Karhale"

# Twitter
NEXT_PUBLIC_TWITTER_SITE="" # @yourtwitterhandle
NEXT_PUBLIC_TWITTER_CREATOR="" # @yourtwitterhandle

# Meta
NEXT_PUBLIC_META_AUTHOR="Abhinav Karhale"
NEXT_PUBLIC_META_THEME_COLOR="" # #000000

# Links
NEXT_PUBLIC_GITHUB_URL="" # https://github.com/yourusername
NEXT_PUBLIC_WEBSITE_URL="" # https://yourdomain.com
NEXT_PUBLIC_INSTAGRAM_URL="" # https://www.instagram.com/yourinstagram/
NEXT_PUBLIC_TWITTER_URL="" # https://twitter.com/yourtwitterhandle
NEXT_PUBLIC_FACEBOOK_URL="" # https://facebook.com/yourfacebookpage

# Emails
NEXT_PUBLIC_ORDER_EMAIL="" # orders@yourdomain.com
NEXT_PUBLIC_SUPPORT_EMAIL="" # support@yourdomain.com
NEXT_PUBLIC_REPLY_TO_EMAIL="" # reply@yourdomain.com
NEXT_PUBLIC_NO_REPLY_EMAIL="" # noreply@yourdomain.com

# Features
NEXT_PUBLIC_AI_ENABLED="false"
NEXT_PUBLIC_STORE_ENABLED="false"
NEXT_PUBLIC_REVIEWS_ENABLED="" # false
NEXT_PUBLIC_SHOW_TAX="" # false

# Rate Limiting
NEXT_PUBLIC_RATE_LIMIT_UPLOAD="" # 10
NEXT_PUBLIC_RATE_LIMIT_IMAGE_PROCESSING="" # 20
NEXT_PUBLIC_RATE_LIMIT_AI_GENERATION="" # 5
NEXT_PUBLIC_RATE_LIMIT_PASSWORD_ATTEMPT="" # 10
NEXT_PUBLIC_RATE_LIMIT_EMAIL="" # 5
NEXT_PUBLIC_RATE_LIMIT_WEBHOOK="" # 100
NEXT_PUBLIC_RATE_LIMIT_CHECKOUT="" # 10
NEXT_PUBLIC_RATE_LIMIT_REVALIDATE="" # 20
NEXT_PUBLIC_ADMIN_MULTIPLIER="" # 3

# Upload Size Limits (in MB)
NEXT_PUBLIC_UPLOAD_LIMIT_IMAGE="" # 20
NEXT_PUBLIC_UPLOAD_LIMIT_BLOG="" # 5
NEXT_PUBLIC_UPLOAD_LIMIT_ABOUT="" # 20
NEXT_PUBLIC_UPLOAD_LIMIT_CUSTOM="" # 20
NEXT_PUBLIC_UPLOAD_LIMIT_FILES="" # 20

NEXT_PUBLIC_CONFIG_LOCATION="" # ENV
