# Database connection string
DATABASE_URL="postgresql://user:password@host:port/database_name?sslmode=require"

# Razorpay (payments for the print store)
# Storefront + checkout are enabled only when both keys are present
# (see isStoreEnabledServer in src/lib/store-utils.ts).
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# Same key id as above, exposed to the browser for Razorpay Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# Webhook secret you set in the Razorpay dashboard when adding the endpoint
# https://<your-domain>/api/razorpay/webhook  (event: payment.captured).
# Without it, paid orders are only confirmed by the browser callback.
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# Storefront toggle (set to false to 404 the whole store)
NEXT_PUBLIC_STORE_ENABLED="true"

# Cloudflare R2 credentials
R2_ACCESS_KEY_ID="20-character-key"
R2_SECRET_ACCESS_KEY="40-character-secret-key"
R2_ACCOUNT_ID="32-character-account-id"
R2_REGION="auto"
R2_IMAGE_BUCKET_NAME="your-public-image-bucket"
R2_BLOG_IMG_BUCKET_NAME="your-blog-image-bucket"
R2_ABOUT_IMG_BUCKET_NAME="your-about-image-bucket"
R2_CUSTOM_IMG_BUCKET_NAME="your-custom-image-bucket"

# Optional: comma-separated fallback list for the admin file browser when the
# R2 token cannot call ListBuckets.
# R2_BUCKET_NAMES="bucket-a,bucket-b"

# Resend API key (format: re_...). Optional: without it, password reset,
# email verification and order emails are disabled. Checkout still works.
# RESEND_API_KEY="re_123456789abcdef..."

# Vercel Edge Config URL (optional, unused unless you add Vercel Flags)
# EDGE_CONFIG="https://edge-config.vercel.com/your-project-id/main"

# Feature flags secret (32+ characters). Still required by src/env.js.
# Generate with: openssl rand -base64 32
FLAGS_SECRET="your-32-character-minimum-secret"

# JWT configuration
# Generate with: openssl rand -base64 32
JWT_SECRET="your-strong-secret-key-min-32-chars"
JWT_EXPIRATION_HOURS="720"

# Optional: enables AI metadata generation for uploads
GOOGLE_GENERATIVE_AI_API_KEY="your_google_ai_api_key_here"

# Optional: Lightroom publish service
LIGHTROOM_API_KEY="your-lightroom-api-key"

# Application URL
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin notification inbox (optional; required for storage alerts)
ADMIN_EMAIL="you@yourdomain.com"

# Cron job authentication secret (generate with: openssl rand -base64 32)
CRON_SECRET="your-cron-secret-key-here"

# Upstash Redis for rate limiting
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"
# Vercel KV integrations provide these names instead; src/env.js accepts either.
# UPSTASH_REDIS_REST_KV_REST_API_URL="https://..."
# UPSTASH_REDIS_REST_KV_REST_API_TOKEN="..."
